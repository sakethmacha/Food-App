@{
    ViewData["Title"] = "FoodieHub";
}

<link rel="stylesheet" href="~/css/style.css" />

<header>
    <div class="header-content">
        <h1>🍔 FoodieHub</h1>
        <span>Fresh food, delivered with love ❤️</span>
    </div>
</header>

<main class="container">

    <!-- Welcome Section -->
    <section class="welcome-section">
        <div>
            <h2>Hungry? You're in the right place!</h2>
            <p>Discover delicious food and order your favourites.</p>
        </div>
        <div class="welcome-icon">🍕</div>
    </section>

    <!-- Food Menu -->
    <section class="menu-section">
        <h2>Explore Our Menu</h2>

        <input type="text"
               id="searchFood"
               placeholder="🔍 Search for pizza, burger, biryani..." />

        <div id="foodList">
            <!-- Food items displayed using JavaScript -->
        </div>
    </section>

    <!-- Shopping Cart -->
    <section class="cart-section">
        <h2>🛒 Your Shopping Cart</h2>

        <div id="cartList">
            <!-- Cart items displayed using JavaScript -->
        </div>

        <div class="cart-total">
            <h3>Total Amount</h3>
            <h2>₹<span id="totalAmount">0</span></h2>
        </div>

        <button id="placeOrder" class="order-button">
            Place Your Order →
        </button>

        <p id="orderMessage"></p>
    </section>

</main>

<footer>
    <p>© 2026 FoodieHub. Made with ❤️ for food lovers.</p>
</footer>

<script type="module" src="~/js/app.js"></script>
