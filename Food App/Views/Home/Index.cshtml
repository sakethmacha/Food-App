@{
    ViewData["Title"] = "FoodieHub";
}

<link rel="stylesheet" href="~/css/style.css" />

<header class="header">
    <h1>🍔 FoodieHub</h1>
    <p>Fresh food, delivered with love ❤️</p>
</header>

<main class="container">

    <section class="welcome">
        <div>
            <h2>Hungry? You're in the right place!</h2>
            <p>Discover delicious food and order your favourites.</p>
        </div>
        <div class="welcome-icon">🍕</div>
    </section>

    <section class="customer-section">
        <h2>Customer Details</h2>

        <input type="text"
               id="customerName"
               placeholder="Enter your name" />

        <select id="customerType">
            <option value="regular">Regular Customer</option>
            <option value="premium">Premium Customer</option>
        </select>
    </section>

    <section class="menu-section">
        <h2>Explore Our Menu</h2>

        <input type="text"
               id="searchFood"
               placeholder="🔍 Search for food..." />

        <div id="foodList"></div>
    </section>

    <section class="cart-section">
        <h2>🛒 Your Shopping Cart</h2>

        <div id="cartList"></div>

        <div class="cart-total">
            <div>
                <p>Subtotal</p>
                <h3>₹<span id="totalAmount">0</span></h3>
            </div>

            <div>
                <p>Discount</p>
                <h3>₹<span id="discountAmount">0</span></h3>
            </div>

            <div>
                <p>Final Amount</p>
                <h2>₹<span id="finalAmount">0</span></h2>
            </div>
        </div>

        <button id="placeOrder" class="order-button">
            Place Your Order →
        </button>

        <p id="orderMessage"></p>
    </section>

</main>

<footer>
    <p>© 2026 FoodieHub. Made with ❤️</p>
</footer>

<script type="module" src="~/js/app.js"></script>
